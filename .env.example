# ─────────────────────────────────────────────────────
# KARASA — Environment Variables
# Salin file ini ke .env.local dan isi nilai-nilainya.
# JANGAN commit .env.local ke Git!
# ─────────────────────────────────────────────────────

# Midtrans (Sandbox dulu untuk testing)
# Daftar di: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# WhatsApp
NEXT_PUBLIC_WA_NUMBER=6281234567890

# URL Toko
NEXT_PUBLIC_GOFOOD_URL=https://gofood.co.id/bandung/restaurant/karasa-xxxxx
NEXT_PUBLIC_GRABFOOD_URL=https://grab.com/id/food/karasa-xxxxx
NEXT_PUBLIC_STORE_NAME=Karasa

# URL Aplikasi (ganti setelah deploy ke Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
